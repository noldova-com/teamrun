{
  "name": "teamrun-app",
  "version": "0.0.10",
  "workspaces": [
    "src/noldova.teamrun.window.app"
  ],
  "desktop": {
    "protocolVersion": 1,
    "modules": [
      {
        "id": "teamrun",
        "package": "@noldova/teamrun"
      },
      {
        "id": "terminal",
        "package": "@noldova/terminal"
      },
      {
        "id": "checkpoints",
        "package": "@noldova/checkpoints"
      },
      {
        "id": "computer-use",
        "package": "@noldova/computer-use"
      },
      {
        "id": "browser",
        "package": "@noldova/browser"
      },
      {
        "id": "git",
        "package": "@noldova/git"
      },
      {
        "id": "git-github",
        "package": "@noldova/git.github"
      }
    ],
    "product": {
      "name": "TeamRun",
      "publisher": "Noldova",
      "installFolder": "Noldova",
      "slug": "teamrun",
      "applicationId": "com.noldova.teamrun",
      "developmentApplicationId": "com.noldova.teamrun.development",
      "dataFolder": ".noldova/teamrun",
      "deviceFolders": {
        "windows": "Noldova/TeamRun",
        "macos": "Noldova/TeamRun",
        "linux": "noldova/teamrun"
      },
      "dataDirectoryVariable": "TEAMRUN_DATA_DIR",
      "icons": "assets/icons",
      "releaseRepository": "noldova-com/downloads",
      "updateFeed": "https://updates.teamrun.noldova.com/",
      "about": {
        "website": "https://teamrun.noldova.com/"
      },
      "permissionsModule": "teamrun",
      "windowsSigning": {
        "endpoint": "https://wus3.codesigning.azure.net/",
        "account": "noldova-signing",
        "profile": "TeamRun"
      }
    },
    "supportedTargets": [
      "linux-x64",
      "linux-arm64",
      "windows-x64",
      "windows-arm64",
      "macos-x64",
      "macos-arm64"
    ],
    "signedPlatforms": [
      "windows",
      "macos",
      "linux"
    ],
    "packaging": {
      "acceptedLicenses": {
        "@anthropic-ai/claude-agent-sdk@0.3.263": {
          "license": "SEE LICENSE IN README.md",
          "reason": "The Agent SDK that TeamRun's Claude provider runs on; its terms are Anthropic's, accepted for TeamRun."
        }
      },
      "omittedOptionals": {
        "@anthropic-ai/claude-agent-sdk@0.3.263": {
          "dependencies": [
            "@anthropic-ai/claude-agent-sdk-darwin-arm64",
            "@anthropic-ai/claude-agent-sdk-darwin-x64",
            "@anthropic-ai/claude-agent-sdk-linux-arm64",
            "@anthropic-ai/claude-agent-sdk-linux-arm64-musl",
            "@anthropic-ai/claude-agent-sdk-linux-x64",
            "@anthropic-ai/claude-agent-sdk-linux-x64-musl",
            "@anthropic-ai/claude-agent-sdk-win32-arm64",
            "@anthropic-ai/claude-agent-sdk-win32-x64"
          ],
          "reason": "TeamRun starts the claude program the person installed, through the SDK's pathToClaudeCodeExecutable, and never loads the one these packages bundle."
        }
      }
    }
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "scripts": {
    "build": "noldova-desktop-build build",
    "install:window": "noldova-desktop-build install",
    "package": "noldova-desktop-build package",
    "package:smoke": "noldova-desktop-build package-smoke",
    "release:assets": "noldova-desktop-build release-assets",
    "seed:stress": "node seed-stress.ts",
    "start": "noldova-desktop-build start"
  },
  "dependencies": {
    "@noldova/browser": "0.0.6",
    "@noldova/checkpoints": "0.0.3",
    "@noldova/computer-use": "0.0.2",
    "@noldova/context.collections": "0.0.18",
    "@noldova/context.core": "0.0.18",
    "@noldova/context.data": "0.0.18",
    "@noldova/context.data.sql": "0.0.18",
    "@noldova/context.data.sql.sqlite": "0.0.18",
    "@noldova/context.exceptions": "0.0.18",
    "@noldova/context.json": "0.0.18",
    "@noldova/context.processes": "0.0.18",
    "@noldova/context.text": "0.0.18",
    "@noldova/desktop.cli": "0.0.16",
    "@noldova/desktop.electron": "0.0.16",
    "@noldova/desktop.protocol": "0.0.16",
    "@noldova/desktop.runtime": "0.0.16",
    "@noldova/git": "0.0.6",
    "@noldova/git.github": "0.0.6",
    "@noldova/teamrun": "0.0.10",
    "@noldova/terminal": "0.0.7"
  },
  "devDependencies": {
    "@noldova/desktop.build": "0.0.16",
    "electron": "44.9.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "content-type": "2.1.0"
    }
  },
  "allowScripts": {
    "node-pty": false
  }
}
