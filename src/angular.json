{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "teamrun": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "nol",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "vitest.config.mts",
            "browsers": [
              "chromiumHeadless"
            ],
            "browserViewport": "1280x800",
            "include": [
              "noldova.teamrun.window/tests/**/*.spec.ts"
            ],
            "providersFile": "noldova.teamrun.window/tests/test-providers.ts",
            "setupFiles": [
              "noldova.teamrun.window/tests/resource-timing.setup.ts",
              "noldova.teamrun.window/tests/page-stalls.setup.ts",
              "noldova.teamrun.window/tests/resize-observer-loops.setup.ts",
              "noldova.teamrun.window/tests/kit-stylesheet.setup.ts"
            ],
            "watch": false,
            "coverage": true,
            "coverageInclude": [
              "noldova.teamrun/src/api/window.ts",
              "noldova.teamrun.window/src/**/*.ts"
            ],
            "coverageExclude": [
              "noldova.teamrun.window/src/**/*.d.ts"
            ],
            "coverageReporters": [
              "text",
              "json-summary"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../_build/window",
            "tsConfig": "tsconfig.spec.json",
            "styles": [
              "@noldova/ui.components.angular/styles/kit.css"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
