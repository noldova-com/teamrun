{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "teamrun": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "tr",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "vitest.config.mts",
            "browsers": [
              "chromiumHeadless"
            ],
            "browserViewport": "1280x800",
            "include": [
              "shell/ui/tests/**/*.spec.ts",
              "shell/window/tests/**/*.spec.ts",
              "modules/*/window/tests/**/*.spec.ts"
            ],
            "providersFile": "shell/ui/tests/test-providers.ts",
            "watch": false,
            "coverage": true,
            "coverageInclude": [
              "shell/ui/src/**/*.ts",
              "shell/window/src/**/*.ts",
              "modules/*/window/src/**/*.ts"
            ],
            "coverageReporters": [
              "text"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            },
            "coverageExclude": [
              "shell/ui/src/app/enums/**",
              "shell/window/src/app/enums/**",
              "modules/*/window/src/app/enums/**"
            ]
          }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../_build/window",
            "index": "shell/window/src/index.html",
            "browser": "shell/window/src/main.ts",
            "tsConfig": "tsconfig.spec.json",
            "baseHref": "./",
            "styles": [
              "shell/ui/src/styles/kit.scss"
            ]
          },
          "configurations": {
            "production": {
              "tsConfig": "tsconfig.app.json",
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
