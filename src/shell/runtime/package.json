{
  "name": "@noldova/teamrun-shell-runtime",
  "version": "__VERSION__",
  "private": true,
  "type": "module",
  "main": "api/index.js",
  "types": "api/index.d.ts",
  "license": "MIT",
  "dependencies": {
    "@noldova/teamrun-foundation-core": "__VERSION__",
    "@noldova/teamrun-foundation-exceptions": "__VERSION__",
    "@noldova/teamrun-foundation-json": "__VERSION__",
    "@noldova/teamrun-shell-protocol": "__VERSION__"
  },
  "teamrun": {
    "windowsAddons": [
      "windows-process"
    ],
    "coverageExclusions": [
      {
        "file": "services/process/windows-process-api.ts",
        "reason": "Loads the Windows addon, which only a Windows build contains; the process tests run it natively there."
      }
    ]
  }
}
