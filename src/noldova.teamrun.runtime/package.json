{
  "name": "@noldova/teamrun.runtime",
  "version": "__VERSION__",
  "private": true,
  "description": "TeamRun's runtime part: the chat engine and its providers hosted by Noldova Desktop Runtime, with its methods, events and database.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/teamrun.git",
    "directory": "src/noldova.teamrun.runtime"
  },
  "homepage": "https://github.com/noldova-com/teamrun#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/teamrun/issues"
  },
  "exports": {
    ".": {
      "types": "./api/index.d.ts",
      "default": "./api/index.js"
    },
    "./development": {
      "types": "./api/development.d.ts",
      "default": "./api/development.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.js.map",
    "api/index.d.ts",
    "api/development.d.ts"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noldova/teamrun.cli": "__VERSION__",
    "@noldova/teamrun.core": "__VERSION__",
    "@noldova/teamrun.protocol": "__VERSION__",
    "@noldova/teamrun.providers": "__VERSION__",
    "@noldova/teamrun.services": "__VERSION__"
  },
  "peerDependencies": {
    "@noldova/checkpoints": "0.0.3",
    "@noldova/context.core": ">=0.0.10 <0.1.0",
    "@noldova/context.data": ">=0.0.10 <0.1.0",
    "@noldova/context.data.sql": ">=0.0.10 <0.1.0",
    "@noldova/context.data.sql.sqlite": ">=0.0.10 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.10 <0.1.0",
    "@noldova/context.json": ">=0.0.10 <0.1.0",
    "@noldova/desktop.cli": ">=0.0.11 <0.1.0",
    "@noldova/desktop.protocol": ">=0.0.11 <0.1.0",
    "@noldova/desktop.runtime": ">=0.0.11 <0.1.0",
    "@noldova/terminal.protocol": "0.0.5"
  }
}
