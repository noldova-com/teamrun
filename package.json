{
  "name": "teamrun",
  "version": "0.0.1",
  "teamrun": {
    "protocolVersion": 1,
    "modules": [],
    "product": {
      "name": "TeamRun",
      "publisher": "Noldova",
      "slug": "teamrun",
      "applicationId": "com.noldova.teamrun",
      "developmentApplicationId": "com.noldova.teamrun.development",
      "dataFolder": ".noldova/teamrun",
      "deviceFolders": {
        "windows": "Noldova/TeamRun",
        "macos": "Noldova/TeamRun",
        "linux": "noldova/teamrun"
      },
      "dataDirectoryVariable": "TEAMRUN_DATA_DIR",
      "icons": "assets/icons"
    }
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": "11.19.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "electron node_modules/@noldova/teamrun-shell-desktop/main.js",
    "test": "node scripts/test.ts",
    "test:ui": "node scripts/ui-workflows.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.2.0",
    "electron": "44.5.1",
    "typescript": "7.0.2"
  }
}
