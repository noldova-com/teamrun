{
  "name": "@noldova/teamrun",
  "version": "0.0.10",
  "teamrun": {
    "protocolVersion": "0.2"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "workspaces": [
    "src",
    "src/noldova.teamrun.docs"
  ],
  "scripts": {
    "build": "node scripts/installs/root-install.ts && node scripts/build.ts",
    "build:app": "node scripts/app.ts build",
    "build:docs": "npm run docs:build --workspace src/noldova.teamrun.docs",
    "format:documents": "node scripts/format-documents.ts",
    "install:app": "node scripts/app.ts install",
    "install:root": "node scripts/installs/root-install.ts --with-scripts",
    "lock:app": "node scripts/app.ts lock",
    "package:app": "node scripts/app.ts package",
    "package:smoke": "node scripts/app.ts package-smoke",
    "relock:app": "npm run install:root && npm run build && npm run lock:app",
    "profile": "node scripts/profile/profile.ts",
    "profile:read": "node scripts/profile/profile-read.ts",
    "seed:stress": "node scripts/app.ts seed-stress",
    "set-version": "node scripts/set-version.ts",
    "start": "node scripts/app.ts start",
    "test": "node scripts/test.ts",
    "test:angular": "node scripts/test.ts angular",
    "test:docs": "npm run docs:test --workspace src/noldova.teamrun.docs",
    "probe:image": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe/image-path.ps1",
    "probe:paths": "node -e \"const fs=require('fs');for(const p of [process.cwd(),'app',require('os').tmpdir()]){console.log('PROBE',p,'|',fs.realpathSync(p),'|',fs.realpathSync.native(p))}\"",
    "test:e2e": "node node_modules/playwright/cli.js test --config src/noldova.teamrun/tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.127.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noldova/checkpoints": "0.0.3",
    "@noldova/checkpoints.protocol": "0.0.3",
    "@noldova/context.collections": "0.0.18",
    "@noldova/context.core": "0.0.18",
    "@noldova/context.data": "0.0.18",
    "@noldova/context.data.sql": "0.0.18",
    "@noldova/context.data.sql.sqlite": "0.0.18",
    "@noldova/context.exceptions": "0.0.18",
    "@noldova/context.json": "0.0.18",
    "@noldova/context.processes": "0.0.18",
    "@noldova/desktop.cli": "0.0.16",
    "@noldova/desktop.protocol": "0.0.16",
    "@noldova/desktop.runtime": "0.0.16",
    "@noldova/terminal.protocol": "0.0.7"
  },
  "devDependencies": {
    "@noldova/computer-use": "0.0.2",
    "@noldova/computer-use.runtime": "0.0.2",
    "@noldova/context.testing": "0.0.18",
    "@noldova/context.text": "0.0.18",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
