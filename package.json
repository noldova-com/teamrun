{
  "name": "@noldova/teamrun",
  "version": "0.0.1",
  "teamrun": {
    "protocolVersion": "0.2"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "workspaces": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/installs/root-install.ts && node scripts/build.ts",
    "build:app": "node scripts/app.ts build",
    "format:documents": "node scripts/format-documents.ts",
    "install:app": "node scripts/app.ts install",
    "install:root": "npm ci --no-audit --no-fund",
    "lock:app": "node scripts/app.ts lock",
    "package:app": "node scripts/app.ts package",
    "package:smoke": "node scripts/app.ts package-smoke",
    "relock:app": "npm run install:root && npm run build && npm run lock:app",
    "profile": "node scripts/profile/profile.ts",
    "profile:read": "node scripts/profile/profile-read.ts",
    "seed:stress": "node scripts/app.ts seed-stress",
    "start": "node scripts/app.ts start",
    "test": "node scripts/test.ts",
    "test:angular": "node scripts/test.ts angular",
    "test:e2e": "node node_modules/playwright/cli.js test --config src/noldova.teamrun/tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.127.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noldova/checkpoints": "0.0.3",
    "@noldova/checkpoints.protocol": "0.0.3",
    "@noldova/context.core": "0.0.8",
    "@noldova/context.data": "0.0.8",
    "@noldova/context.data.sql": "0.0.8",
    "@noldova/context.data.sql.sqlite": "0.0.8",
    "@noldova/context.exceptions": "0.0.8",
    "@noldova/context.json": "0.0.8",
    "@noldova/desktop.cli": "0.0.4",
    "@noldova/desktop.protocol": "0.0.4",
    "@noldova/desktop.runtime": "0.0.4",
    "@noldova/terminal.protocol": "0.0.2"
  },
  "devDependencies": {
    "@noldova/computer-use": "0.0.2",
    "@noldova/computer-use.runtime": "0.0.2",
    "@noldova/context.testing": "0.0.8",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
